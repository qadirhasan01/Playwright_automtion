# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored so secrets never get committed.

# Base URL of the application under test (ReqRes API root).
BASE_URL=https://reqres.in/api

# ReqRes now accepts a free shared key. Get your own at https://app.reqres.in
# for a higher daily limit. The shared demo key below works out of the box.
API_KEY=reqres-free-v1

# Header name the API expects the key in.
API_KEY_HEADER=x-api-key

# Per-request timeout in milliseconds.
API_TIMEOUT=30000

# Max acceptable response time (ms) used by response-time assertions.
MAX_RESPONSE_TIME_MS=3000
