{
  "name": "reqres-api-automation",
  "version": "1.0.0",
  "description": "Industry-standard API automation framework built with Playwright + TypeScript against https://reqres.in",
  "scripts": {
    "test": "playwright test",
    "test:get": "playwright test tests/get",
    "test:post": "playwright test tests/post",
    "test:put": "playwright test tests/put",
    "test:patch": "playwright test tests/patch",
    "test:delete": "playwright test tests/delete",
    "test:negative": "playwright test tests/negative",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-automation",
    "reqres",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.3.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
